# Copy to .env. Every value is optional except where noted.

# Image version to run (a release number such as 0.1.0 pins it; latest follows new releases).
FACTORIO_MCP_VERSION=latest

# Where the Factorio server keeps its data (the folder that contains config/rconpw). Required.
FACTORIO_DATA_DIR=/path/to/factorio-data
# Numeric user id that owns config/rconpw (the container runs as this user).
FACTORIO_MCP_UID=845

# Address the MCP service listens on. Bind to the address of your private network
# interface of a VPN or similar, never to a public one: there is no TLS.
FACTORIO_MCP_HOST=127.0.0.1
FACTORIO_MCP_PORT=8787
# Host header values the service accepts (comma-separated). Set this whenever the service is
# reachable by anything but localhost, e.g. "192.0.2.10,server.example.com".
FACTORIO_MCP_ALLOWED_HOSTS=

# RCON of the game server (same machine). The password is read from the file mounted by
# docker-compose.mcp.yml; FACTORIO_MCP_RCON_PASSWORD would override it.
FACTORIO_MCP_RCON_HOST=127.0.0.1
FACTORIO_MCP_RCON_PORT=27015

FACTORIO_MCP_LOG_LEVEL=INFO
